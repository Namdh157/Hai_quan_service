<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="BackendMessageStoreStandardEndpoint" xmlns="http://ws.apache.org/ns/synapse">
    <http method="post" uri-template="http://192.168.0.133:8080/api/v1/messages/store">
        <suspendOnFailure>
            <initialDuration>2000</initialDuration>
            <progressionFactor>1.5</progressionFactor>
            <maximumDuration>5000</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>3</retriesBeforeSuspension>
        </markForSuspension>
    </http>
</endpoint>
