<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="BackendAuthForgotPassEmailEndpoint" xmlns="http://ws.apache.org/ns/synapse">
    <http method="post" uri-template="http://192.168.0.133:8080/api/v1/auth/forgot-password">
        <suspendOnFailure>
            <initialDuration>1000</initialDuration>
            <progressionFactor>1.5</progressionFactor>
            <maximumDuration>5000</maximumDuration>
        </suspendOnFailure>
    </http>
</endpoint>
