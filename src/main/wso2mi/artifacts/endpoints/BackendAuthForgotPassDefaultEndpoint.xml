<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="BackendAuthForgotPassDefaultEndpoint" xmlns="http://ws.apache.org/ns/synapse">
    <http method="post" uri-template="http://192.168.0.133:8080/api/v1/auth/forgot-password">
        <suspendOnFailure>
            <initialDuration>2000</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>3000</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>3</retriesBeforeSuspension>
        </markForSuspension>
    </http>
</endpoint>
