<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="BackendAuthLogoutStandardEndpoint" xmlns="http://ws.apache.org/ns/synapse">
    <http method="post" uri-template="http://192.168.0.133:8080/api/v1/auth/logout">
        <suspendOnFailure>
            <initialDuration>1000</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>2000</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>3</retriesBeforeSuspension>
        </markForSuspension>
    </http>
</endpoint>
