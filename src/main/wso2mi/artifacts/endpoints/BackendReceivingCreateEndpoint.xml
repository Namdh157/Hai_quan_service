<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="BackendReceivingCreateEndpoint" xmlns="http://ws.apache.org/ns/synapse">
    <!-- Cấu hình trỏ tới biến $SYSTEM:URL_BACKEND_RECEIVING_CREATE -->
    <http method="post" uri-template="http://192.168.0.133:8080/api/v1/receiving/registrations">
        <suspendOnFailure>
            <initialDuration>2000</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>3000</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>0</retriesBeforeSuspension>
        </markForSuspension>
    </http>
</endpoint>
