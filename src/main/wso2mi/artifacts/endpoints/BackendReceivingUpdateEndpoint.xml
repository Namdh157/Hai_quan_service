<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="BackendReceivingUpdateEndpoint" xmlns="http://ws.apache.org/ns/synapse">
    <!-- Nối thêm path params vào endpoint thông qua uri.var.registrationId -->
    <http method="post" uri-template="http://192.168.0.133:8080/api/v1/internal/registrations/{uri.var.registrationId}/amend">
        <suspendOnFailure>
            <initialDuration>2000</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>3000</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>0</retriesBeforeSuspension>
        </markForSuspension>
    </http>
</endpoint>
