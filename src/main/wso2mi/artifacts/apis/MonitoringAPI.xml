<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/monitoring"
     name="MonitoringAPI"
     xmlns="http://ws.apache.org/ns/synapse">

    <!-- ================================================= -->
    <!-- UC-87: Health Check                               -->
    <!-- ================================================= -->
    <resource methods="GET" uri-template="/health">
        <inSequence>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC87-SystemHealthCheck"/>
            </log>

            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <http.get configKey="BackendConnection">
                <relativePath>/api/v1/monitoring/health</relativePath>
            </http.get>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-87\] Fault Occurred During Health Check"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================================================= -->
    <!-- UC-88: Performance Metrics                        -->
    <!-- ================================================= -->
    <resource methods="GET" uri-template="/metrics">
        <inSequence>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC88-PerformanceMetrics"/>
            </log>

            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <http.get configKey="BackendConnection">
                <relativePath>/api/v1/monitoring/metrics</relativePath>
            </http.get>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-88\] Fault Occurred During Metrics Retrieval"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================================================= -->
    <!-- UC-89: Queue Monitoring                           -->
    <!-- ================================================= -->
    <resource methods="GET" uri-template="/queues">
        <inSequence>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC89-QueueMonitoring"/>
            </log>

            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <http.get configKey="BackendConnection">
                <relativePath>/api/v1/monitoring/queues</relativePath>
            </http.get>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-89\] Fault Occurred During Queue Monitoring"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

</api>
