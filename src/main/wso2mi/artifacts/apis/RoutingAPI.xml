<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/routingapi" name="RoutingAPI" xmlns="http://ws.apache.org/ns/synapse">
    <!-- ================= UC-26 ================= -->
    <resource methods="POST" uri-template="/dispatch">
        <inSequence>
            <!-- 1. Extract Properties -->
            <property name="requestId" expression="//requestId/text()" scope="default"/>
            <property name="registrationId" expression="//registrationId/text()" scope="default"/>
            <property name="procedureCode" expression="//procedureCode/text()" scope="default"/>
            <!-- Forward content type transparently (optional but kept from original scope) -->
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" value="/api/v1/routing/dispatch" scope="default"/>

            <!-- 2. Validate Compulsory Fields -->
            <filter xpath="string-length(get-property('requestId')) = 0 or string-length(get-property('registrationId')) = 0 or string-length(get-property('procedureCode')) = 0">
                <then>
                    <!-- Missing required arguments -> Return 400 -->
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>400</code>
                                <message>Missing compulsory fields (requestId, registrationId or procedureCode)</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <!-- 3. Validation Passed -> Log Details -->
                    <log level="custom">
                        <property name="UseCase" value="UC26-RoutingDispatch"/>
                        <property name="requestId" expression="get-property('requestId')"/>
                        <property name="registrationId" expression="get-property('registrationId')"/>
                        <property name="procedureCode" expression="get-property('procedureCode')"/>
                        <property name="backendPath" expression="get-property('backendPath')"/>
                    </log>

                    <!-- 4. Backend Call - Forward down to BE to handle the actual routing -->
                    <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
                    <header name="Content-Type" expression="get-property('contentType')" scope="transport"/>
                    <http.post configKey="BackendConnection">
                        <relativePath>{$ctx:backendPath}</relativePath>
                    </http.post>
                    <respond/>
                </else>
            </filter>

        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="full">
                <property name="Status" value="\[UC-26\] Fault Occurred"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================= UC-27 ================= -->
    <resource methods="POST" uri-template="/resend/{messageId}">
        <inSequence>
            <!-- 1. Extract Properties -->
            <property name="messageId" expression="get-property('uri.var.messageId')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" expression="fn:concat('/api/v1/routing/resend/', get-property('messageId'))" scope="default"/>

            <!-- 2. Validate Compulsory Fields -->
            <filter xpath="string-length(get-property('messageId')) = 0">
                <then>
                    <!-- Missing required arguments -> Return 400 -->
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>400</code>
                                <message>Missing compulsory field (messageId)</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <!-- 3. Validation Passed -> Log Details -->
                    <log level="custom">
                        <property name="UseCase" value="UC27-RoutingResend"/>
                        <property name="messageId" expression="get-property('messageId')"/>
                        <property name="backendPath" expression="get-property('backendPath')"/>
                    </log>

                    <!-- 4. Backend Call -->
                    <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
                    <http.post configKey="BackendConnection">
                        <relativePath>{$ctx:backendPath}</relativePath>
                    </http.post>
                    <respond/>
                </else>
            </filter>

        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="full">
                <property name="Status" value="\[UC-27\] Fault Occurred"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================= UC-28 ================= -->
    <resource methods="POST" uri-template="/resend">
        <inSequence>
            <!-- 1. Extract Properties -->
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" value="/api/v1/routing/resend" scope="default"/>
            <property name="messageCount" expression="count(//messageId)" scope="default"/>

            <!-- 2. Validate Compulsory Fields -->
            <filter xpath="count(//messageId) = 0">
                <then>
                    <!-- Missing required arguments -> Return 400 -->
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>400</code>
                                <message>Missing compulsory fields (at least one messageId required in the batch)</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <!-- 3. Validation Passed -> Log Details -->
                    <log level="custom">
                        <property name="UseCase" value="UC28-RoutingResendBatch"/>
                        <property name="messageCount" expression="get-property('messageCount')"/>
                        <property name="backendPath" expression="get-property('backendPath')"/>
                    </log>

                    <!-- 4. Backend Call -->
                    <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
                    <http.post configKey="BackendConnection">
                        <relativePath>{$ctx:backendPath}</relativePath>
                    </http.post>
                    <respond/>
                </else>
            </filter>

        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="full">
                <property name="Status" value="\[UC-28\] Fault Occurred"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

</api>
