<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/receiving/registrations"
     name="ReceivingAPI"
     xmlns="http://ws.apache.org/ns/synapse">

    <!-- ================= UC22 ================= -->
    <resource methods="POST" uri-template="/">

        <inSequence>

            <property name="authToken"
                      expression="get-property('ReceivingBackendToken')"
                      scope="default"/>

            <header name="Authorization"
                    expression="get-property('authToken')"
                    scope="transport"/>

            <log level="custom">
                <property name="UseCase" value="UC22-NewRegistration"/>
            </log>

            <http.post configKey="BackendConnection">
                <relativePath>/api/v1/receiving/registrations</relativePath>
            </http.post>

            <respond/>

        </inSequence>

    </resource>


    <!-- ================= UC23 ================= -->
    <resource methods="POST" uri-template="/{registrationId}/amend">

        <inSequence>

            <property name="registrationId"
                      expression="get-property('uri.var.registrationId')"
                      scope="default"/>

            <property name="authToken"
                      expression="get-property('ReceivingBackendToken')"
                      scope="default"/>

            <header name="Authorization"
                    expression="get-property('authToken')"
                    scope="transport"/>

            <log level="custom">
                <property name="UseCase" value="UC23-AmendRegistration"/>
                <property name="registrationId"
                          expression="get-property('registrationId')"/>
            </log>

            <http.post configKey="BackendConnection">
                <relativePath>
                    /api/v1/internal/registrations/{uri.var.registrationId}/amend
                </relativePath>
            </http.post>

            <respond/>

        </inSequence>

    </resource>


    <!-- ================= UC24 ================= -->
    <resource methods="POST" uri-template="/{registrationId}/cancel">

        <inSequence>

            <!-- Lấy registrationId -->
            <property name="registrationId"
                    expression="get-property('uri.var.registrationId')"
                    scope="default"/>

            <!-- Lấy cancelReason -->
            <property name="cancelReason"
                    expression="//cancelReason/text()"
                    scope="default"/>

            <!-- Token -->
            <property name="authToken"
                    expression="get-property('BackendAuthToken')"
                    scope="default"/>

            <!-- Build backend path -->
            <property name="backendPath"
                    expression="fn:concat('/api/v1/receiving/registrations/', get-property('registrationId'), '/cancel')"
                    scope="default"/>

            <!-- Log -->
            <log level="custom">
                <property name="UseCase" value="UC24-CancelRegistration"/>
                <property name="registrationId" expression="get-property('registrationId')"/>
                <property name="cancelReason" expression="get-property('cancelReason')"/>
                <property name="backendPath" expression="get-property('backendPath')"/>
                <property name="authToken" expression="get-property('authToken')"/>
            </log>

            <!-- Authorization -->
            <header name="Authorization"
                    expression="get-property('authToken')"
                    scope="transport"/>

            <!-- Call backend -->
            <http.post configKey="BackendConnection">
                <relativePath>{$ctx:backendPath}</relativePath>
            </http.post>

            <respond/>

            </inSequence>

    </resource>

</api>