<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/receiving/registrations" name="ReceivingAPI" xmlns="http://ws.apache.org/ns/synapse">
    <!-- UC-22: Tiếp nhận đăng ký hồ sơ mới -->
    <resource methods="POST" uri-template="/">
        <inSequence>
            <!-- Đọc Content-Type từ request để forward xuống backend -->
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <log level="custom">
                <property name="Status" value="[UC-22] Received New Registration Request"/>
                <property name="requestId" expression="//requestId/text()"/>
                <property name="procedureCode" expression="//procedureCode/text()"/>
                <property name="enterpriseId" expression="//enterpriseId/text()"/>
            </log>

            <http.post configKey="BackendConnection">
                <relativePath>/api/v1/receiving/registrations</relativePath>
                <headers>[["Content-Type","{$ctx:contentType}"]]</headers>
                <responseVariable>createResponse</responseVariable>
            </http.post>

            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Error" value="[UC-22] Error Processing New Registration"/>
                <property name="ERROR_CODE" expression="get-property('ERROR_CODE')"/>
                <property name="ERROR_MESSAGE" expression="get-property('ERROR_MESSAGE')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- UC-23: Tiếp nhận sửa hồ sơ -->
    <resource methods="POST" uri-template="/{registrationId}/amend">
        <inSequence>
            <!-- Đọc Content-Type từ request để forward xuống backend -->
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <log level="custom">
                <property name="Status" value="[UC-23] Received Registration Amend Request"/>
                <property name="registrationId" expression="get-property('uri.var.registrationId')"/>
                <property name="requestId" expression="//requestId/text()"/>
            </log>

            <http.post configKey="BackendConnection">
                <relativePath>/api/v1/internal/registrations/{uri.var.registrationId}/amend</relativePath>
                <headers>[["Content-Type","{$ctx:contentType}"]]</headers>
                <responseVariable>amendResponse</responseVariable>
            </http.post>

            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Error" value="[UC-23] Error Processing Registration Amend"/>
                <property name="ERROR_CODE" expression="get-property('ERROR_CODE')"/>
                <property name="ERROR_MESSAGE" expression="get-property('ERROR_MESSAGE')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- UC-24: Tiếp nhận hủy hồ sơ -->
    <resource methods="POST" uri-template="/{registrationId}/cancel">

        <inSequence>
            <!-- Đọc Content-Type từ request để forward xuống backend -->
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>

            <!-- Extract Path Param -->
            <property name="registrationId"
                      expression="get-property('uri.var.registrationId')"
                      scope="default"/>

            <!-- Extract Request Fields -->
            <property name="requestId"
                      expression="//requestId/text()"
                      scope="default"/>
            <property name="cancelReason"
                      expression="//cancelReason/text()"
                      scope="default"/>
            <property name="procedureCode"
                      expression="//procedureCode/text()"
                      scope="default"/>

            <!-- Log Request -->
            <log level="custom">
                <property name="UseCase" value="[UC-24] Receive Cancel Registration"/>
                <property name="registrationId" expression="get-property('registrationId')"/>
                <property name="requestId" expression="get-property('requestId')"/>
                <property name="procedureCode" expression="get-property('procedureCode')"/>
                <property name="cancelReason" expression="get-property('cancelReason')"/>
            </log>

            <!-- Validate cancelReason mandatory -->
            <filter xpath="string-length(get-property('cancelReason')) = 0">
                <then>
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>400</code>
                                <message>cancelReason is required</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <http.post configKey="BackendConnection">
                        <relativePath>/api/v1/receiving/registrations/{uri.var.registrationId}/cancel</relativePath>
                        <headers>[["Content-Type","{$ctx:contentType}"]]</headers>
                        <responseVariable>cancelResponse</responseVariable>
                    </http.post>
                </else>
            </filter>

            <respond/>

        </inSequence>

        <outSequence/>

        <faultSequence>
            <log level="custom">
                <property name="Error" value="[UC-24] Failed"/>
                <property name="registrationId" expression="get-property('registrationId')"/>
                <property name="requestId" expression="get-property('requestId')"/>
            </log>
            <respond/>
        </faultSequence>

    </resource>
</api>
