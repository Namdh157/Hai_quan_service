    <!-- ========================================================= -->
    <!-- UC-34: Lấy danh sách phản hồi theo doanh nghiệp           -->
    <!-- GET /api/v1/response?enterpriseId=...&status=...          -->
    <!-- ========================================================= -->
    <resource methods="GET" uri-template="/response">
        <inSequence>
            <log level="custom">
                <property name="Status" value="[UC-34] Received Response Query By Enterprise Request"/>
                <property name="enterpriseId" expression="get-property('query.param.enterpriseId')"/>
                <property name="status" expression="get-property('query.param.status')"/>
            </log>

            <!-- Validate enterpriseId là bắt buộc theo tài liệu -->
            <filter xpath="string-length(normalize-space(get-property('query.param.enterpriseId'))) = 0">
                <then>
                    <payloadFactory media-type="json">
                        <format>
                            {
                              "success": false,
                              "error": {
                                "code": "BAD_REQUEST",
                                "message": "enterpriseId is required"
                              }
                            }
                        </format>
                        <args/>
                    </payloadFactory>
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <respond/>
                </then>
                <else>
                    <call>
                        <endpoint key="BackendResponseQueryByEnterpriseEndpoint"/>
                    </call>
                    <respond/>
                </else>
            </filter>
        </inSequence>

        <outSequence>
            <respond/>
        </outSequence>

        <faultSequence>
            <log level="custom">
                <property name="Error" value="[UC-34] Error Response Query By Enterprise"/>
                <property name="enterpriseId" expression="get-property('query.param.enterpriseId')"/>
                <property name="status" expression="get-property('query.param.status')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

