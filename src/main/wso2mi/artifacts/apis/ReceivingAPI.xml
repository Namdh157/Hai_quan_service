<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/receiving/registrations" name="ReceivingAPI" xmlns="http://ws.apache.org/ns/synapse">

    <!-- ================= UC-22: Tiếp nhận hồ sơ ================= -->
    <resource methods="POST" uri-template="/">
        <inSequence>

            <property name="contentType"
                      expression="get-property('axis2','ContentType')"
                      scope="default"/>

            <property name="authToken"
                      value="Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsInJvbGUiOiJBRE1JTiIsImlhdCI6MTc3MzIxMjIzNSwiZXhwIjoxNzczMjk4NjM1fQ.7wYswUnTzHKtsFURBLEBFHhJuLXoJooRoIorP56Uuew"
                      scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC22-NewRegistration"/>
                <property name="requestId" expression="//requestId/text()"/>
            </log>

            <header name="Authorization" action="remove" scope="transport"/>

            <header name="Authorization"
                    expression="get-property('authToken')"
                    scope="transport"/>

            <header name="Content-Type"
                    expression="get-property('contentType')"
                    scope="transport"/>

            <call>
                <endpoint>
                    <http method="POST"
                          uri-template="http://192.168.10.196:8080/api/v1/receiving/registrations"/>
                </endpoint>
            </call>

            <respond/>

        </inSequence>

        <outSequence/>

        <faultSequence>
            <log level="custom">
                <property name="Error" value="UC22 Error"/>
                <property name="ERROR_MESSAGE" expression="get-property('ERROR_MESSAGE')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>


    <!-- ================= UC-23: Sửa hồ sơ ================= -->
    <resource methods="POST" uri-template="/{registrationId}/amend">

        <inSequence>

            <property name="contentType"
                      expression="get-property('axis2','ContentType')"
                      scope="default"/>

            <property name="authToken"
                      value="Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsInJvbGUiOiJBRE1JTiIsImlhdCI6MTc3MzIxMjIzNS," 
                      scope="default"/>

            <property name="registrationId"
                      expression="get-property('uri.var.registrationId')"
                      scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC23-AmendRegistration"/>
                <property name="registrationId" expression="get-property('registrationId')"/>
            </log>

            <header name="Authorization" action="remove" scope="transport"/>

            <header name="Authorization"
                    expression="get-property('authToken')"
                    scope="transport"/>

            <header name="Content-Type"
                    expression="get-property('contentType')"
                    scope="transport"/>

            <call>
                <endpoint>
                    <http method="POST"
                          uri-template="http://192.168.10.196:8080/api/v1/internal/registrations/{uri.var.registrationId}/amend"/>
                </endpoint>
            </call>

            <respond/>

        </inSequence>

        <outSequence/>

        <faultSequence>
            <log level="custom">
                <property name="Error" value="UC23 Error"/>
                <property name="ERROR_MESSAGE" expression="get-property('ERROR_MESSAGE')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>


    <!-- ================= UC-24: Hủy hồ sơ ================= -->
    <resource methods="POST" uri-template="/{registrationId}/cancel">

        <inSequence>

            <property name="contentType"
                      expression="get-property('axis2','ContentType')"
                      scope="default"/>

            <property name="authToken"
                      value="Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsInJvbGUiOiJBRE1JTiIsImlhdCI6MTc3MzIxMjIzNSwiZXhwIjoxNzczMjk4NjM1fQ.7wYswUnTzHKtsFURBLEBFHhJuLXoJooRoIorP56Uuew"
                      scope="default"/>

            <property name="registrationId"
                      expression="get-property('uri.var.registrationId')"
                      scope="default"/>

            <property name="cancelReason"
                      expression="//cancelReason/text()"
                      scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC24-CancelRegistration"/>
                <property name="registrationId" expression="get-property('registrationId')"/>
                <property name="cancelReason" expression="get-property('cancelReason')"/>
            </log>

            <!-- Validate cancelReason -->
            <filter xpath="string-length(get-property('cancelReason')) = 0">
                <then>

                    <property name="HTTP_SC" value="400" scope="axis2"/>

                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>400</code>
                                <message>cancelReason is required</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>

                    <respond/>

                </then>

                <else>

                    <header name="Authorization" action="remove" scope="transport"/>

                    <header name="Authorization"
                            expression="get-property('authToken')"
                            scope="transport"/>

                    <header name="Content-Type"
                            expression="get-property('contentType')"
                            scope="transport"/>

                    <call>
                        <endpoint>
                            <http method="POST"
                                  uri-template="http://192.168.10.196:8080/api/v1/receiving/registrations/{uri.var.registrationId}/cancel"/>
                        </endpoint>
                    </call>

                </else>

            </filter>

            <respond/>

        </inSequence>

        <outSequence/>

        <faultSequence>
            <log level="custom">
                <property name="Error" value="UC24 Error"/>
                <property name="ERROR_MESSAGE" expression="get-property('ERROR_MESSAGE')"/>
            </log>
            <respond/>
        </faultSequence>

    </resource>

</api>