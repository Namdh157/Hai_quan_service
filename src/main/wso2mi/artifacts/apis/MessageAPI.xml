<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/messages" name="MessagesAPI" xmlns="http://ws.apache.org/ns/synapse">

    <!-- ================= UC-29 ================= -->
    <resource methods="POST" uri-template="/parse">
        <inSequence>
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" value="/api/v1/messages/parse" scope="default"/>

            <!-- Log -->
            <log level="custom">
                <property name="UseCase" value="UC29-MessageParse"/>
                <property name="backendPath" expression="get-property('backendPath')"/>
                <property name="Action" value="Forwarding message for parsing"/>
            </log>

            <!-- Backend Call -->
            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <header name="Content-Type" expression="get-property('contentType')" scope="transport"/>
            <http.post configKey="BackendConnection">
                <relativePath>{$ctx:backendPath}</relativePath>
            </http.post>
            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-29\] Fault Occurred During Message Parse Routing"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================= UC-30 ================= -->
    <resource methods="POST" uri-template="/store">
        <inSequence>
            <!-- 1. Extract Properties -->
            <property name="messageId" expression="//messageId/text()" scope="default"/>
            <property name="hasParsedContent" expression="boolean(//parsedContent)" scope="default" type="BOOLEAN"/>
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" value="/api/v1/messages/store" scope="default"/>

            <!-- 2. Processing (Validation Removed as per user request) -->
            <log level="custom">
                <property name="UseCase" value="UC30-MessageStore"/>
                <property name="messageId" expression="get-property('messageId')"/>
                <property name="backendPath" expression="get-property('backendPath')"/>
                <property name="Action" value="Forwarding parsed content to Backend for DB storage"/>
            </log>

            <!-- 3. Backend Call -->
            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <header name="Content-Type" expression="get-property('contentType')" scope="transport"/>
            <http.post configKey="BackendConnection">
                <relativePath>{$ctx:backendPath}</relativePath>
            </http.post>
            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-30\] Fault Occurred During Message Store Routing"/>
                <property name="messageId" expression="get-property('messageId')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

</api>
