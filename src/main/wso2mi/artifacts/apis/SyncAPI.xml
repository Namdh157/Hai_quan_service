<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/sync"
     name="SyncAPI"
     xmlns="http://ws.apache.org/ns/synapse">

    <!-- ================================================= -->
    <!-- UC-83: Đồng bộ danh mục dùng chung                -->
    <!-- ================================================= -->
    <resource methods="POST" uri-template="/master-data">
        <inSequence>
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC83-SyncMasterData"/>
                <property name="Action" value="Requesting master data sync"/>
            </log>

            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <header name="Content-Type" expression="get-property('contentType')" scope="transport"/>
            <http.post configKey="BackendConnection">
                <relativePath>/api/v1/sync/master-data</relativePath>
            </http.post>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-83\] Fault Occurred During Master Data Sync"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================================================= -->
    <!-- UC-84: Đồng bộ hồ sơ                              -->
    <!-- ================================================= -->
    <resource methods="POST" uri-template="/registrations">
        <inSequence>
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC84-SyncRegistration"/>
                <property name="Action" value="Requesting registration sync"/>
            </log>

            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <header name="Content-Type" expression="get-property('contentType')" scope="transport"/>
            <http.post configKey="BackendConnection">
                <relativePath>/api/v1/sync/registrations</relativePath>
            </http.post>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-84\] Fault Occurred During Registration Sync"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================================================= -->
    <!-- UC-85: Tra cứu trạng thái đồng bộ                 -->
    <!-- ================================================= -->
    <resource methods="GET" uri-template="/{syncId}/status">
        <inSequence>
            <property name="syncId" expression="get-property('uri.var.syncId')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" expression="fn:concat('/api/v1/sync/', get-property('syncId'), '/status')" scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC85-SyncStatusQuery"/>
                <property name="syncId" expression="get-property('syncId')"/>
            </log>

            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <http.get configKey="BackendConnection">
                <relativePath>{$ctx:backendPath}</relativePath>
            </http.get>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-85\] Fault Occurred During Sync Status Query"/>
                <property name="syncId" expression="get-property('syncId')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================================================= -->
    <!-- UC-86: Đồng bộ lại dữ liệu lỗi                    -->
    <!-- ================================================= -->
    <resource methods="POST" uri-template="/{syncId}/retry">
        <inSequence>
            <property name="syncId" expression="get-property('uri.var.syncId')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" expression="fn:concat('/api/v1/sync/', get-property('syncId'), '/retry')" scope="default"/>

            <log level="custom">
                <property name="UseCase" value="UC86-SyncRetry"/>
                <property name="syncId" expression="get-property('syncId')"/>
            </log>

            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <http.post configKey="BackendConnection">
                <relativePath>{$ctx:backendPath}</relativePath>
            </http.post>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-86\] Fault Occurred During Sync Retry"/>
                <property name="syncId" expression="get-property('syncId')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

</api>
