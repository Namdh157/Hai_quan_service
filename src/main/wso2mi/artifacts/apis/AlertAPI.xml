<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/alerts" name="AlertAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="POST" uri-template="/">
        <inSequence>
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property name="alertType" expression="//alertType/text()" scope="default" type="STRING"/>
            <property name="severity" expression="//severity/text()" scope="default" type="STRING"/>
            <property name="source" expression="//source/text()" scope="default" type="STRING"/>
            <property name="referenceId" expression="//referenceId/text()" scope="default" type="STRING"/>
            <property name="procedureCode" expression="//procedureCode/text()" scope="default" type="STRING"/>
            <log level="custom">
                <property name="Status" value="[UC-79] System Alert Triggered"/>
                <property name="Type" expression="get-property('alertType')"/>
                <property name="Severity" expression="get-property('severity')"/>
                <property name="Source" expression="get-property('source')"/>
                <property name="RefID" expression="get-property('referenceId')"/>
                <property name="procedureCode" expression="get-property('procedureCode')"/>
            </log>
            <switch source="get-property('procedureCode')">
                <case regex="HQ_CRITICAL">
                    <http.post configKey="BackendConnection">
                        <relativePath>/api/v1/alerts/critical-path</relativePath>
                        <headers>[["Content-Type","{$ctx:contentType}"]]</headers>
                        <responseVariable>alertResponse</responseVariable>
                    </http.post>
                </case>
                <case regex="HQ_MONITOR">
                    <http.post configKey="BackendConnection">
                        <relativePath>/api/v1/alerts/monitoring</relativePath>
                        <headers>[["Content-Type","{$ctx:contentType}"]]</headers>
                        <responseVariable>alertResponse</responseVariable>
                    </http.post>
                </case>
                <default>
                    <http.post configKey="BackendConnection">
                        <relativePath>/api/v1/alerts/create</relativePath>
                        <headers>[["Content-Type","{$ctx:contentType}"]]</headers>
                        <responseVariable>alertResponse</responseVariable>
                    </http.post>
                </default>
            </switch>
            <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Error" value="[UC-79] Failed to create system alert"/>
                <property name="Type" expression="get-property('alertType')"/>
                <property name="Details" expression="get-property('ERROR_MESSAGE')"/>
            </log>
            <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
            <payloadFactory media-type="json">
                <format>{
                    "errorCode": "ALERT_001",
                    "status": "FAILED",
                    "message": "Không thể khởi tạo cảnh báo",
                    "detail": "$1"
                }</format>
                <args>
                    <arg evaluator="xml" expression="get-property('ERROR_MESSAGE')"/>
                </args>
            </payloadFactory>
            <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
            <respond/>
        </faultSequence>
    </resource>
    <!-- uc 80 -->
    <resource methods="GET" uri-template="/">
        <inSequence>
            <property expression="$url:severity" name="severity" scope="default" type="STRING"/>
            <property expression="$url:status" name="status" scope="default" type="STRING"/>
            <property expression="$url:procedureCode" name="procedureCode" scope="default" type="STRING"/>
            <property expression="$url:page" name="page" scope="default" type="STRING"/>
            <property expression="$url:size" name="size" scope="default" type="STRING"/>
            <log level="custom">
                <property name="Status" value="[UC-80] Searching Alerts"/>
                <property name="severity" expression="get-property('severity')"/>
                <property name="status" expression="get-property('status')"/>
                <property name="procedureCode" expression="get-property('procedureCode')"/>
            </log>
            <switch source="get-property('procedureCode')">
                <case regex="HQ_MONITOR">
                    <http.get configKey="BackendConnection">
                        <relativePath>/api/v1/alerts/monitor-view</relativePath>
                        <headers>[["Accept","application/json"]]</headers>
                        <responseVariable>searchResponse</responseVariable>
                    </http.get>
                </case>
                <default>
                    <http.get configKey="BackendConnection">
                        <relativePath>/api/v1/alerts</relativePath>
                        <headers>[["Accept","application/json"]]</headers>
                        <responseVariable>searchResponse</responseVariable>
                    </http.get>
                </default>
            </switch>
            <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Error" value="[UC-80] Search Alerts Failed"/>
                <property name="Details" expression="get-property('ERROR_MESSAGE')"/>
            </log>
            <payloadFactory media-type="json">
                <format>{"errorCode": "ALERT_QUERY_ERR", "message": "Lỗi tra cứu cảnh báo"}</format>
                <args/>
            </payloadFactory>
            <respond/>
        </faultSequence>
    </resource>
    <resource methods="PUT" uri-template="/{alertId}">
        <inSequence>
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property expression="get-property('uri.var.alertId')" name="alertId" scope="default" type="STRING"/>
            <property expression="//status/text()" name="newStatus" scope="default" type="STRING"/>
            <property expression="//procedureCode/text()" name="procedureCode" scope="default" type="STRING"/>
            <log level="custom">
                <property name="Status" value="[UC-80] Updating Alert Status"/>
                <property name="alertId" expression="get-property('alertId')"/>
                <property name="newStatus" expression="get-property('newStatus')"/>
                <property name="procedureCode" expression="get-property('procedureCode')"/>
            </log>
            <switch source="get-property('procedureCode')">
                <case regex="HQ_AUDIT">
                    <http.put configKey="BackendConnection">
                        <relativePath>/api/v1/alerts/audit/{$ctx:alertId}</relativePath>
                        <headers>[["Content-Type","{$ctx:contentType}"]]</headers>
                        <responseVariable>updateResponse</responseVariable>
                    </http.put>
                </case>
                <default>
                    <http.put configKey="BackendConnection">
                        <relativePath>/api/v1/alerts/{$ctx:alertId}</relativePath>
                        <headers>[["Content-Type","{$ctx:contentType}"]]</headers>
                        <responseVariable>updateResponse</responseVariable>
                    </http.put>
                </default>
            </switch>
            <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
            <respond/>
        </inSequence>
        <faultSequence>
            <log level="custom">
                <property name="Error" value="[UC-80] Update Alert Failed"/>
                <property name="alertId" expression="get-property('alertId')"/>
            </log>
            <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
            <payloadFactory media-type="json">
                <format>{"errorCode": "ALERT_UPDATE_ERR", "message": "Cập nhật cảnh báo thất bại"}</format>
                <args/>
            </payloadFactory>
            <respond/>
        </faultSequence>
    </resource>
    <!-- -->
</api>