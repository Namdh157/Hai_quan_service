<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/signature" name="SignatureVerifyAPI" xmlns="http://ws.apache.org/ns/synapse">
    <!-- UC-25: Xác thực chữ ký số -->
    <resource methods="POST" uri-template="/verify">
        <inSequence>
            <!-- Đọc Content-Type từ request để forward xuống backend -->
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <!-- Load Backend Auth Token -->
            <property name="authToken" expression="get-property('registry', 'local://BackendAuthToken')" scope="default"/>
            <!-- Extract Request Fields -->
            <property name="requestId"
                      expression="//requestId/text()"
                      scope="default"/>
            <property name="procedureCode"
                      expression="//procedureCode/text()"
                      scope="default"/>
            <property name="signedData"
                      expression="//signedData/text()"
                      scope="default"/>
            <property name="signatureValue"
                      expression="//signature/text()"
                      scope="default"/>
            <property name="signTime"
                      expression="//signTime/text()"
                      scope="default"/>

            <!-- Log Request -->
            <log level="custom">
                <property name="UseCase" value="[UC-25] Signature Verification"/>
                <property name="requestId" expression="get-property('requestId')"/>
                <property name="procedureCode" expression="get-property('procedureCode')"/>
                <property name="signTime" expression="get-property('signTime')"/>
            </log>

            <!-- Validate Mandatory Fields -->
            <filter xpath="string-length(get-property('requestId')) = 0
                           or string-length(get-property('signedData')) = 0
                           or string-length(get-property('signatureValue')) = 0
                           or string-length(get-property('signTime')) = 0">
                <then>
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>SIG_001</code>
                                <message>Invalid signature format</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <http.post configKey="BackendConnection">
                        <relativePath>/api/v1/signature/verify</relativePath>
                        <headers>[["Content-Type","{$ctx:contentType}"],["Authorization","{$ctx:authToken}"]]</headers>
                        <responseVariable>verifyResponse</responseVariable>
                    </http.post>
                </else>
            </filter>

            <!-- Log Verification Result -->
            <log level="custom">
                <property name="UseCase" value="[UC-25] Verification Completed"/>
                <property name="requestId" expression="get-property('requestId')"/>
                <property name="certificateSerial" expression="//signer/serialNumber/text()"/>
                <property name="verificationResult" expression="//valid/text()"/>
            </log>

            <respond/>

        </inSequence>

        <outSequence/>

        <faultSequence>
            <log level="custom">
                <property name="Error" value="[UC-25] Failed"/>
                <property name="requestId" expression="get-property('requestId')"/>
            </log>
            <respond/>
        </faultSequence>

    </resource>
</api>