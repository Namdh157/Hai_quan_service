<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/response" name="ResponseAPI" xmlns="http://ws.apache.org/ns/synapse">
  <!-- UC-31: Đóng gói thông điệp trả lời -->
  <resource methods="POST" uri-template="/package">
    <inSequence>
      <!-- Extract Request Fields -->
      <property name="registrationId" expression="//registrationId/text()" scope="default"/>
      <property name="procedureCode" expression="//procedureCode/text()" scope="default"/>
      <property name="responseCode" expression="//responseCode/text()" scope="default"/>
      <property name="responseMessage" expression="//responseMessage/text()" scope="default"/>
      <!-- Log Request -->
      <log level="custom">
        <property name="UseCase" value="[UC-31] Response Packaging"/>
        <property name="registrationId" expression="get-property('registrationId')"/>
        <property name="procedureCode" expression="get-property('procedureCode')"/>
        <property name="responseCode" expression="get-property('responseCode')"/>
        <property name="responseMessage" expression="get-property('responseMessage')"/>
      </log>
      <!-- Validate Mandatory Fields -->
      <filter xpath="string-length(get-property('registrationId')) = 0 
                           or string-length(get-property('responseCode')) = 0 
                           or string-length(get-property('responseMessage')) = 0">
        <then>
          <property name="HTTP_SC" value="400" scope="axis2"/>
          <payloadFactory media-type="xml">
            <format>
              <error>
                <code>400</code>
                <message>Missing mandatory fields</message>
              </error>
            </format>
            <args/>
          </payloadFactory>
          <respond/>
        </then>
        <else>
          <!-- Switch by procedureCode -->
          <switch source="get-property('procedureCode')">
            <case regex=".*">
              <call>
                <endpoint key="BackendResponsePackageEndpoint"/>
              </call>
            </case>
            <default>
              <property name="HTTP_SC" value="400" scope="axis2"/>
              <payloadFactory media-type="xml">
                <format>
                  <error>
                    <code>400</code>
                    <message>Invalid procedureCode</message>
                  </error>
                </format>
                <args/>
              </payloadFactory>
              <respond/>
            </default>
          </switch>
        </else>
      </filter>
      <respond/>
    </inSequence>
    <outSequence/>
    <faultSequence>
      <log level="custom">
        <property name="Error" value="[UC-31] Failed"/>
        <property name="registrationId" expression="get-property('registrationId')"/>
      </log>
      <respond/>
    </faultSequence>
  </resource>
  <!-- UC-32: Nhận phản hồi từ hệ thống nghiệp vụ -->
  <resource methods="POST" uri-template="/receive">
    <inSequence>
      <!-- Extract Request Fields -->
      <property name="responseId" expression="//responseId/text()" scope="default"/>
      <property name="registrationId" expression="//registrationId/text()" scope="default"/>
      <property name="procedureCode" expression="//procedureCode/text()" scope="default"/>
      <!-- Log Request -->
      <log level="custom">
        <property name="UseCase" value="[UC-32] Receive Business Response"/>
        <property name="responseId" expression="get-property('responseId')"/>
        <property name="registrationId" expression="get-property('registrationId')"/>
        <property name="procedureCode" expression="get-property('procedureCode')"/>
      </log>
      <!-- Validate Mandatory Fields -->
      <filter xpath="string-length(get-property('responseId')) = 0 
                           or string-length(get-property('registrationId')) = 0">
        <then>
          <property name="HTTP_SC" value="400" scope="axis2"/>
          <payloadFactory media-type="xml">
            <format>
              <error>
                <code>400</code>
                <message>Missing mandatory fields</message>
              </error>
            </format>
            <args/>
          </payloadFactory>
          <respond/>
        </then>
        <else>
          <!-- Switch by procedureCode -->
          <switch source="get-property('procedureCode')">
            <case regex=".*">
              <call>
                <endpoint key="BackendResponseReceiveEndpoint"/>
              </call>
            </case>
            <default>
              <property name="HTTP_SC" value="400" scope="axis2"/>
              <payloadFactory media-type="xml">
                <format>
                  <error>
                    <code>400</code>
                    <message>Invalid procedureCode</message>
                  </error>
                </format>
                <args/>
              </payloadFactory>
              <respond/>
            </default>
          </switch>
        </else>
      </filter>
      <respond/>
    </inSequence>
    <outSequence/>
    <faultSequence>
      <log level="custom">
        <property name="Error" value="[UC-32] Failed"/>
        <property name="responseId" expression="get-property('responseId')"/>
        <property name="registrationId" expression="get-property('registrationId')"/>
      </log>
      <respond/>
    </faultSequence>
  </resource>
  <!-- UC-33: Lấy phản hồi theo thông điệp -->
  <resource methods="GET" uri-template="/{registrationId}">
    <inSequence>
      <!-- Extract Path Param -->
      <property name="registrationId" expression="get-property('uri.var.registrationId')" scope="default"/>
      <!-- Extract procedureCode from query param (nếu có) -->
      <property name="procedureCode" expression="get-property('uri.var.procedureCode')" scope="default"/>
      <!-- Log Request -->
      <log level="custom">
        <property name="UseCase" value="[UC-33] Query Single Response"/>
        <property name="registrationId" expression="get-property('registrationId')"/>
        <property name="procedureCode" expression="get-property('procedureCode')"/>
      </log>
      <!-- Validate registrationId -->
      <filter xpath="string-length(get-property('registrationId')) = 0">
        <then>
          <property name="HTTP_SC" value="400" scope="axis2"/>
          <payloadFactory media-type="xml">
            <format>
              <error>
                <code>400</code>
                <message>registrationId is required</message>
              </error>
            </format>
            <args/>
          </payloadFactory>
          <respond/>
        </then>
        <else>
          <!-- Switch by procedureCode -->
          <switch source="get-property('procedureCode')">
            <case regex=".*">
              <call>
                <endpoint key="BackendResponseQueryOneEndpoint"/>
              </call>
            </case>
            <default>
              <!-- Nếu không truyền procedureCode vẫn cho phép gọi -->
              <call>
                <endpoint key="BackendResponseQueryOneEndpoint"/>
              </call>
            </default>
          </switch>
        </else>
      </filter>
      <respond/>
    </inSequence>
    <outSequence/>
    <faultSequence>
      <log level="custom">
        <property name="Error" value="[UC-33] Failed"/>
        <property name="registrationId" expression="get-property('registrationId')"/>
      </log>
      <respond/>
    </faultSequence>
  </resource>
  <!-- UC-34: Lấy danh sách phản hồi theo doanh nghiệp -->
  <resource methods="GET" uri-template="">
    <inSequence>
      <!-- Extract Query Params -->
      <property name="enterpriseId" expression="get-property('query.param.enterpriseId')" scope="default"/>
      <property name="status" expression="get-property('query.param.status')" scope="default"/>
      <property name="procedureCode" expression="get-property('query.param.procedureCode')" scope="default"/>
      <!-- Log Request -->
      <log level="custom">
        <property name="UseCase" value="[UC-34] Query Responses By Enterprise"/>
        <property name="enterpriseId" expression="get-property('enterpriseId')"/>
        <property name="status" expression="get-property('status')"/>
        <property name="procedureCode" expression="get-property('procedureCode')"/>
      </log>
      <!-- Validate enterpriseId -->
      <filter xpath="string-length(get-property('enterpriseId')) = 0">
        <then>
          <property name="HTTP_SC" value="400" scope="axis2"/>
          <payloadFactory media-type="xml">
            <format>
              <error>
                <code>400</code>
                <message>enterpriseId is required</message>
              </error>
            </format>
            <args/>
          </payloadFactory>
          <respond/>
        </then>
        <else>
          <!-- Switch by procedureCode -->
          <switch source="get-property('procedureCode')">
            <case regex=".*">
              <call>
                <endpoint key="BackendResponseQueryByEnterpriseEndpoint"/>
              </call>
            </case>
            <default>
              <!-- Allow call even if procedureCode not provided -->
              <call>
                <endpoint key="BackendResponseQueryByEnterpriseEndpoint"/>
              </call>
            </default>
          </switch>
        </else>
      </filter>
      <respond/>
    </inSequence>
    <outSequence/>
    <faultSequence>
      <log level="custom">
        <property name="Error" value="[UC-34] Failed"/>
        <property name="enterpriseId" expression="get-property('enterpriseId')"/>
      </log>
      <respond/>
    </faultSequence>
  </resource>
</api>