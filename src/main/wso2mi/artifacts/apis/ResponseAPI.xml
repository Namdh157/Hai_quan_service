<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/v1/response"
     name="ResponseAPI"
     xmlns="http://ws.apache.org/ns/synapse">

    <!-- ================================================= -->
    <!-- UC-31: Response Packaging -->
    <!-- ================================================= -->
    <resource methods="POST" uri-template="/package">
        <inSequence>

            <!-- 1. Extract Properties -->
            <property name="registrationId" expression="//registrationId/text()" scope="default"/>
            <property name="hasProcessingResult" expression="boolean(//processingResult)" scope="default" type="BOOLEAN"/>
            <property name="responseCode" expression="//responseCode/text()" scope="default"/>
            <property name="responseMessage" expression="//responseMessage/text()" scope="default"/>
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" value="/api/v1/response/package" scope="default"/>

            <!-- 2. Processing (Validation Removed as per user request) -->
            <log level="custom">
                <property name="UseCase" value="UC31-ResponsePack"/>
                <property name="registrationId" expression="get-property('registrationId')"/>
                <property name="responseCode" expression="get-property('responseCode')"/>
                <property name="backendPath" expression="get-property('backendPath')"/>
                <property name="Action" value="Forwarding un-packaged data to Backend to generate final response structure"/>
            </log>

            <!-- 4. Backend Call -->
            <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
            <header name="Content-Type" expression="get-property('contentType')" scope="transport"/>
            <http.post configKey="BackendConnection">
                <relativePath>{$ctx:backendPath}</relativePath>
            </http.post>
            <respond/>

        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-31\] Fault Occurred During Response Formatting"/>
                <property name="registrationId" expression="get-property('registrationId')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>


    <!-- ================================================= -->
    <!-- UC-32: Receive Response -->
    <!-- ================================================= -->
    <resource methods="POST" uri-template="/receive">
        <inSequence>

            <!-- 1. Extract Properties -->
            <property name="responseId" expression="//responseId/text()" scope="default"/>
            <property name="registrationId" expression="//registrationId/text()" scope="default"/>
            <property name="hasPayload" expression="boolean(//payload)" scope="default" type="BOOLEAN"/>
            <property name="contentType" expression="get-property('axis2', 'ContentType')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" value="/api/v1/response/receive" scope="default"/>

            <!-- 2. Validate Compulsory Fields -->
            <filter xpath="string-length(get-property('responseId')) = 0 or string-length(get-property('registrationId')) = 0 or get-property('hasPayload') = 'false'">
                <then>
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>400</code>
                                <message>Missing compulsory fields (responseId, registrationId, or payload) for Response Receiving.</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <!-- 3. Validation Passed -> Log Details -->
                    <log level="custom">
                        <property name="UseCase" value="UC32-ResponseReceive"/>
                        <property name="responseId" expression="get-property('responseId')"/>
                        <property name="registrationId" expression="get-property('registrationId')"/>
                        <property name="backendPath" expression="get-property('backendPath')"/>
                        <property name="Action" value="Forwarding response to Backend to store and update state to WAITING_FOR_DELIVERY"/>
                    </log>

                    <!-- 4. Backend Call - Forward down to BE to handle DB logic and State Mgmt -->
                    <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
                    <header name="Content-Type" expression="get-property('contentType')" scope="transport"/>
                    <http.post configKey="BackendConnection">
                        <relativePath>{$ctx:backendPath}</relativePath>
                    </http.post>
                    <respond/>
                </else>
            </filter>

        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-32\] Fault Occurred During Response Receiving"/>
                <property name="responseId" expression="get-property('responseId')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>


    <!-- ================================================= -->
    <!-- UC-33: Query Single Response -->
    <!-- ================================================= -->
    <resource methods="GET" uri-template="/{registrationId}">
        <inSequence>
            <!-- 1. Extract Properties -->
            <property name="registrationId" expression="get-property('uri.var.registrationId')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <property name="backendPath" expression="fn:concat('/api/v1/responses/', get-property('registrationId'))" scope="default"/>

            <!-- 2. Validate Compulsory Fields -->
            <filter xpath="string-length(get-property('registrationId')) = 0">
                <then>
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>400</code>
                                <message>Missing compulsory field (registrationId)</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <!-- 3. Validation Passed -> Log Details -->
                    <log level="custom">
                        <property name="UseCase" value="UC33-ResponseQueryOne"/>
                        <property name="registrationId" expression="get-property('registrationId')"/>
                        <property name="backendPath" expression="get-property('backendPath')"/>
                    </log>

                    <!-- 4. Backend Call -->
                    <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
                    <http.get configKey="BackendConnection">
                        <relativePath>{$ctx:backendPath}</relativePath>
                    </http.get>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-33\] Fault Occurred"/>
                <property name="registrationId" expression="get-property('registrationId')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

    <!-- ================================================= -->
    <!-- UC-34: Query By Enterprise -->
    <!-- ================================================= -->
    <resource methods="GET" uri-template="">
        <inSequence>
            <!-- 1. Extract Properties -->
            <property name="enterpriseId" expression="get-property('query.param.enterpriseId')" scope="default"/>
            <property name="status" expression="get-property('query.param.status')" scope="default"/>
            <property name="authToken" expression="get-property('BackendAuthToken')" scope="default"/>
            <!-- Construct backend path with query params -->
            <property name="backendPath" expression="fn:concat('/api/v1/responses?enterpriseId=', get-property('enterpriseId'), '&amp;status=', get-property('status'))" scope="default"/>

            <!-- 2. Validate Compulsory Fields -->
            <filter xpath="string-length(get-property('enterpriseId')) = 0">
                <then>
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="xml">
                        <format>
                            <error>
                                <code>400</code>
                                <message>Missing compulsory query parameter (enterpriseId)</message>
                            </error>
                        </format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <!-- 3. Validation Passed -> Log Details -->
                    <log level="custom">
                        <property name="UseCase" value="UC34-ResponseQueryByEnterprise"/>
                        <property name="enterpriseId" expression="get-property('enterpriseId')"/>
                        <property name="status" expression="get-property('status')"/>
                        <property name="backendPath" expression="get-property('backendPath')"/>
                    </log>

                    <!-- 4. Backend Call -->
                    <header name="Authorization" expression="get-property('authToken')" scope="transport"/>
                    <http.get configKey="BackendConnection">
                        <relativePath>{$ctx:backendPath}</relativePath>
                    </http.get>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="custom">
                <property name="Status" value="\[UC-34\] Fault Occurred"/>
                <property name="enterpriseId" expression="get-property('enterpriseId')"/>
            </log>
            <respond/>
        </faultSequence>
    </resource>

</api>