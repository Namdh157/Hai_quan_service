<?xml version="1.0" encoding="UTF-8"?>
<localEntry key="BackendConnection" xmlns="http://ws.apache.org/ns/synapse">
<endpoint name="BackendConnection" xmlns="http://ws.apache.org/ns/synapse">
    <http uri-template="http://192.168.10.196:8080">
        <suspendOnFailure>
            <initialDuration>2000</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>3000</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>3</retriesBeforeSuspension>
            <retryDelay>2000</retryDelay>
        </markForSuspension>
        <timeout>
            <duration>30000</duration>
            <responseAction>fault</responseAction>
        </timeout>
    </http>
</endpoint>
</localEntry>
